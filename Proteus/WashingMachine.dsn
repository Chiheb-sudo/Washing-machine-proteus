<?xml version="1.0" encoding="UTF-8"?>
<!-- Proteus ISIS Schematic Design File -->
<DESIGN>
  <HEADER>
    <VERSION>8.9</VERSION>
    <TITLE>Machine à Laver Automatisée - Schéma ISIS</TITLE>
    <FILENAME>WashingMachine.dsn</FILENAME>
    <CREATED>2024-07-10</CREATED>
    <MODIFIED>2024-07-10</MODIFIED>
  </HEADER>

  <SCHEMATIC>
    <PAGE>
      <PAPER>A3</PAPER>
      <ORIENTATION>LANDSCAPE</ORIENTATION>
      <SCALE>100%</SCALE>
    </PAGE>

    <!-- ============ MICROCONTRÔLEUR ============ -->
    <COMPONENT ID="IC1">
      <REFERENCE>U1</REFERENCE>
      <VALUE>Arduino Mega 2560</VALUE>
      <DESCRIPTION>Microcontrôleur Arduino Mega 2560</DESCRIPTION>
      <FOOTPRINT>MEGA2560</FOOTPRINT>
      <POSITION X="500" Y="400"/>
      <ORIENTATION>0</ORIENTATION>
      <PROPERTIES>
        <PROP NAME="FREQUENCY">16MHz</PROP>
        <PROP NAME="FLASH">256KB</PROP>
        <PROP NAME="RAM">8KB</PROP>
        <PROP NAME="IO_PINS">54</PROP>
      </PROPERTIES>
    </COMPONENT>

    <!-- ============ RELAIS ============ -->
    <COMPONENT ID="RELAY1">
      <REFERENCE>K1</REFERENCE>
      <VALUE>Relais 5V 5A</VALUE>
      <DESCRIPTION>Électrovanne eau</DESCRIPTION>
      <PIN NUMBER="1" NAME="IN" X="550" Y="600"/>
      <PIN NUMBER="2" NAME="VCC" X="560" Y="600"/>
      <PIN NUMBER="3" NAME="GND" X="570" Y="600"/>
      <PIN NUMBER="4" NAME="OUT_NO" X="580" Y="600"/>
      <PIN NUMBER="5" NAME="OUT_NC" X="590" Y="600"/>
      <CONNECTED_TO_ARDUINO_PIN>22</CONNECTED_TO_ARDUINO_PIN>
    </COMPONENT>

    <COMPONENT ID="RELAY2">
      <REFERENCE>K2</REFERENCE>
      <VALUE>Relais 5V 5A</VALUE>
      <DESCRIPTION>Électrovanne savon</DESCRIPTION>
      <CONNECTED_TO_ARDUINO_PIN>23</CONNECTED_TO_ARDUINO_PIN>
    </COMPONENT>

    <COMPONENT ID="RELAY3">
      <REFERENCE>K3</REFERENCE>
      <VALUE>Relais 5V 5A</VALUE>
      <DESCRIPTION>Électrovanne détergent</DESCRIPTION>
      <CONNECTED_TO_ARDUINO_PIN>24</CONNECTED_TO_ARDUINO_PIN>
    </COMPONENT>

    <COMPONENT ID="RELAY4">
      <REFERENCE>K4</REFERENCE>
      <VALUE>Relais 5V 5A</VALUE>
      <DESCRIPTION>Électrovanne rinçage</DESCRIPTION>
      <CONNECTED_TO_ARDUINO_PIN>25</CONNECTED_TO_ARDUINO_PIN>
    </COMPONENT>

    <COMPONENT ID="RELAY5">
      <REFERENCE>K5</REFERENCE>
      <VALUE>Relais 5V 5A</VALUE>
      <DESCRIPTION>Pompe vidange</DESCRIPTION>
      <CONNECTED_TO_ARDUINO_PIN>26</CONNECTED_TO_ARDUINO_PIN>
    </COMPONENT>

    <COMPONENT ID="RELAY6">
      <REFERENCE>K6</REFERENCE>
      <VALUE>Relais 5V 5A</VALUE>
      <DESCRIPTION>Moteur essorage</DESCRIPTION>
      <CONNECTED_TO_ARDUINO_PIN>27</CONNECTED_TO_ARDUINO_PIN>
    </COMPONENT>

    <!-- ============ LCD I2C ============ -->
    <COMPONENT ID="LCD1">
      <REFERENCE>LCD1</REFERENCE>
      <VALUE>LCD 20x4 I2C</VALUE>
      <DESCRIPTION>Module LCD I2C 20x4 caractères</DESCRIPTION>
      <PIN NUMBER="1" NAME="GND" CONNECTED="GND"/>
      <PIN NUMBER="2" NAME="VCC" CONNECTED="VCC_5V"/>
      <PIN NUMBER="3" NAME="SDA" CONNECTED="ARDUINO_PIN_20"/>
      <PIN NUMBER="4" NAME="SCL" CONNECTED="ARDUINO_PIN_21"/>
      <I2C_ADDRESS>0x27</I2C_ADDRESS>
      <BACKLIGHT>BLUE_LED</BACKLIGHT>
      <CONTRAST>50%</CONTRAST>
    </COMPONENT>

    <!-- ============ CAPTEURS DE NIVEAU (POTENTIOMÈTRES) ============ -->
    <COMPONENT ID="POT1">
      <REFERENCE>R1</REFERENCE>
      <VALUE>10kΩ</VALUE>
      <DESCRIPTION>Capteur niveau eau</DESCRIPTION>
      <TYPE>POTENTIOMETER</TYPE>
      <PIN NUMBER="1" NAME="VCC" CONNECTED="VCC_5V"/>
      <PIN NUMBER="2" NAME="OUT" CONNECTED="ARDUINO_A0"/>
      <PIN NUMBER="3" NAME="GND" CONNECTED="GND"/>
    </COMPONENT>

    <COMPONENT ID="POT2">
      <REFERENCE>R2</REFERENCE>
      <VALUE>10kΩ</VALUE>
      <DESCRIPTION>Capteur niveau savon</DESCRIPTION>
      <TYPE>POTENTIOMETER</TYPE>
      <PIN NUMBER="1" NAME="VCC" CONNECTED="VCC_5V"/>
      <PIN NUMBER="2" NAME="OUT" CONNECTED="ARDUINO_A1"/>
      <PIN NUMBER="3" NAME="GND" CONNECTED="GND"/>
    </COMPONENT>

    <COMPONENT ID="POT3">
      <REFERENCE>R3</REFERENCE>
      <VALUE>10kΩ</VALUE>
      <DESCRIPTION>Capteur niveau détergent</DESCRIPTION>
      <TYPE>POTENTIOMETER</TYPE>
      <PIN NUMBER="1" NAME="VCC" CONNECTED="VCC_5V"/>
      <PIN NUMBER="2" NAME="OUT" CONNECTED="ARDUINO_A2"/>
      <PIN NUMBER="3" NAME="GND" CONNECTED="GND"/>
    </COMPONENT>

    <COMPONENT ID="POT4">
      <REFERENCE>R4</REFERENCE>
      <VALUE>10kΩ</VALUE>
      <DESCRIPTION>Capteur niveau rinçage</DESCRIPTION>
      <TYPE>POTENTIOMETER</TYPE>
      <PIN NUMBER="1" NAME="VCC" CONNECTED="VCC_5V"/>
      <PIN NUMBER="2" NAME="OUT" CONNECTED="ARDUINO_A3"/>
      <PIN NUMBER="3" NAME="GND" CONNECTED="GND"/>
    </COMPONENT>

    <!-- ============ BOUTONS DE COMMANDE ============ -->
    <COMPONENT ID="SW1">
      <REFERENCE>SW1</REFERENCE>
      <VALUE>Bouton Menu</VALUE>
      <DESCRIPTION>Bouton Menu</DESCRIPTION>
      <TYPE>PUSH_BUTTON</TYPE>
      <PIN NUMBER="1" NAME="PIN28" CONNECTED="ARDUINO_PIN_28"/>
      <PIN NUMBER="2" NAME="GND" CONNECTED="GND"/>
      <DEBOUNCE>200ms</DEBOUNCE>
    </COMPONENT>

    <COMPONENT ID="SW2">
      <REFERENCE>SW2</REFERENCE>
      <VALUE>Bouton Haut</VALUE>
      <DESCRIPTION>Bouton Haut (↑)</DESCRIPTION>
      <TYPE>PUSH_BUTTON</TYPE>
      <PIN NUMBER="1" NAME="PIN29" CONNECTED="ARDUINO_PIN_29"/>
      <PIN NUMBER="2" NAME="GND" CONNECTED="GND"/>
      <DEBOUNCE>200ms</DEBOUNCE>
    </COMPONENT>

    <COMPONENT ID="SW3">
      <REFERENCE>SW3</REFERENCE>
      <VALUE>Bouton Bas</VALUE>
      <DESCRIPTION>Bouton Bas (↓)</DESCRIPTION>
      <TYPE>PUSH_BUTTON</TYPE>
      <PIN NUMBER="1" NAME="PIN30" CONNECTED="ARDUINO_PIN_30"/>
      <PIN NUMBER="2" NAME="GND" CONNECTED="GND"/>
      <DEBOUNCE>200ms</DEBOUNCE>
    </COMPONENT>

    <COMPONENT ID="SW4">
      <REFERENCE>SW4</REFERENCE>
      <VALUE>Bouton OK</VALUE>
      <DESCRIPTION>Bouton OK</DESCRIPTION>
      <TYPE>PUSH_BUTTON</TYPE>
      <PIN NUMBER="1" NAME="PIN31" CONNECTED="ARDUINO_PIN_31"/>
      <PIN NUMBER="2" NAME="GND" CONNECTED="GND"/>
      <DEBOUNCE>200ms</DEBOUNCE>
    </COMPONENT>

    <!-- ============ SIGNAUX MACHINE ============ -->
    <COMPONENT ID="SW5">
      <REFERENCE>SW5</REFERENCE>
      <VALUE>Signal START</VALUE>
      <DESCRIPTION>Signal démarrage automatique</DESCRIPTION>
      <TYPE>PUSH_BUTTON</TYPE>
      <PIN NUMBER="1" NAME="PIN32" CONNECTED="ARDUINO_PIN_32"/>
      <PIN NUMBER="2" NAME="GND" CONNECTED="GND"/>
    </COMPONENT>

    <COMPONENT ID="SW6">
      <REFERENCE>SW6</REFERENCE>
      <VALUE>Signal STOP</VALUE>
      <DESCRIPTION>Signal arrêt automatique</DESCRIPTION>
      <TYPE>PUSH_BUTTON</TYPE>
      <PIN NUMBER="1" NAME="PIN33" CONNECTED="ARDUINO_PIN_33"/>
      <PIN NUMBER="2" NAME="GND" CONNECTED="GND"/>
    </COMPONENT>

    <COMPONENT ID="SW7">
      <REFERENCE>SW7</REFERENCE>
      <VALUE>Signal MODE</VALUE>
      <DESCRIPTION>Signal changement mode</DESCRIPTION>
      <TYPE>PUSH_BUTTON</TYPE>
      <PIN NUMBER="1" NAME="PIN34" CONNECTED="ARDUINO_PIN_34"/>
      <PIN NUMBER="2" NAME="GND" CONNECTED="GND"/>
    </COMPONENT>

    <COMPONENT ID="SW8">
      <REFERENCE>SW8</REFERENCE>
      <VALUE>Signal TEMP</VALUE>
      <DESCRIPTION>Signal changement température</DESCRIPTION>
      <TYPE>PUSH_BUTTON</TYPE>
      <PIN NUMBER="1" NAME="PIN35" CONNECTED="ARDUINO_PIN_35"/>
      <PIN NUMBER="2" NAME="GND" CONNECTED="GND"/>
    </COMPONENT>

    <!-- ============ LEDS INDICATION ============ -->
    <COMPONENT ID="LED1">
      <REFERENCE>D1</REFERENCE>
      <VALUE>LED Rouge 3mm</VALUE>
      <DESCRIPTION>Indication Relais 1</DESCRIPTION>
      <PIN NUMBER="1" NAME="ANODE" CONNECTED="RELAY1_OUT"/>
      <PIN NUMBER="2" NAME="CATHODE" CONNECTED="GND"/>
      <RESISTOR>470Ω</RESISTOR>
    </COMPONENT>

    <COMPONENT ID="LED2">
      <REFERENCE>D2</REFERENCE>
      <VALUE>LED Rouge 3mm</VALUE>
      <DESCRIPTION>Indication Relais 2</DESCRIPTION>
    </COMPONENT>

    <COMPONENT ID="LED3">
      <REFERENCE>D3</REFERENCE>
      <VALUE>LED Rouge 3mm</VALUE>
      <DESCRIPTION>Indication Relais 3</DESCRIPTION>
    </COMPONENT>

    <COMPONENT ID="LED4">
      <REFERENCE>D4</REFERENCE>
      <VALUE>LED Rouge 3mm</VALUE>
      <DESCRIPTION>Indication Relais 4</DESCRIPTION>
    </COMPONENT>

    <COMPONENT ID="LED5">
      <REFERENCE>D5</REFERENCE>
      <VALUE>LED Rouge 3mm</VALUE>
      <DESCRIPTION>Indication Relais 5</DESCRIPTION>
    </COMPONENT>

    <COMPONENT ID="LED6">
      <REFERENCE>D6</REFERENCE>
      <VALUE>LED Rouge 3mm</VALUE>
      <DESCRIPTION>Indication Relais 6</DESCRIPTION>
    </COMPONENT>

    <!-- ============ LEDS BOUTONS ============ -->
    <COMPONENT ID="LED7">
      <REFERENCE>D7</REFERENCE>
      <VALUE>LED Rouge 3mm</VALUE>
      <DESCRIPTION>Indication Menu</DESCRIPTION>
    </COMPONENT>

    <COMPONENT ID="LED8">
      <REFERENCE>D8</REFERENCE>
      <VALUE>LED Rouge 3mm</VALUE>
      <DESCRIPTION>Indication Haut</DESCRIPTION>
    </COMPONENT>

    <COMPONENT ID="LED9">
      <REFERENCE>D9</REFERENCE>
      <VALUE>LED Rouge 3mm</VALUE>
      <DESCRIPTION>Indication Bas</DESCRIPTION>
    </COMPONENT>

    <COMPONENT ID="LED10">
      <REFERENCE>D10</REFERENCE>
      <VALUE>LED Rouge 3mm</VALUE>
      <DESCRIPTION>Indication OK</DESCRIPTION>
    </COMPONENT>

    <!-- ============ LEDS SIGNAUX ============ -->
    <COMPONENT ID="LED11">
      <REFERENCE>D11</REFERENCE>
      <VALUE>LED Bleu 3mm</VALUE>
      <DESCRIPTION>Indication START</DESCRIPTION>
    </COMPONENT>

    <COMPONENT ID="LED12">
      <REFERENCE>D12</REFERENCE>
      <VALUE>LED Bleu 3mm</VALUE>
      <DESCRIPTION>Indication STOP</DESCRIPTION>
    </COMPONENT>

    <COMPONENT ID="LED13">
      <REFERENCE>D13</REFERENCE>
      <VALUE>LED Bleu 3mm</VALUE>
      <DESCRIPTION>Indication MODE</DESCRIPTION>
    </COMPONENT>

    <COMPONENT ID="LED14">
      <REFERENCE>D14</REFERENCE>
      <VALUE>LED Bleu 3mm</VALUE>
      <DESCRIPTION>Indication TEMP</DESCRIPTION>
    </COMPONENT>

    <!-- ============ PROTECTION RELAIS ============ -->
    <COMPONENT ID="DIODE1">
      <REFERENCE>D_PROTECT1</REFERENCE>
      <VALUE>1N4007</VALUE>
      <DESCRIPTION>Diode protection Relais 1</DESCRIPTION>
      <POSITION>PARALLEL_RELAY1_COIL</POSITION>
    </COMPONENT>

    <COMPONENT ID="DIODE2">
      <REFERENCE>D_PROTECT2</REFERENCE>
      <VALUE>1N4007</VALUE>
      <DESCRIPTION>Diode protection Relais 2</DESCRIPTION>
    </COMPONENT>

    <COMPONENT ID="DIODE3">
      <REFERENCE>D_PROTECT3</REFERENCE>
      <VALUE>1N4007</VALUE>
      <DESCRIPTION>Diode protection Relais 3</DESCRIPTION>
    </COMPONENT>

    <COMPONENT ID="DIODE4">
      <REFERENCE>D_PROTECT4</REFERENCE>
      <VALUE>1N4007</VALUE>
      <DESCRIPTION>Diode protection Relais 4</DESCRIPTION>
    </COMPONENT>

    <COMPONENT ID="DIODE5">
      <REFERENCE>D_PROTECT5</REFERENCE>
      <VALUE>1N4007</VALUE>
      <DESCRIPTION>Diode protection Relais 5</DESCRIPTION>
    </COMPONENT>

    <COMPONENT ID="DIODE6">
      <REFERENCE>D_PROTECT6</REFERENCE>
      <VALUE>1N4007</VALUE>
      <DESCRIPTION>Diode protection Relais 6</DESCRIPTION>
    </COMPONENT>

    <!-- ============ ALIMENTATION ============ -->
    <POWER_SUPPLY>
      <VCC NAME="VCC_5V" VALUE="5V"/>
      <GND NAME="GND" VALUE="0V"/>
      <MIN_CURRENT>2000mA</MIN_CURRENT>
      <TYPE>USB_OR_ADAPTER</TYPE>
    </POWER_SUPPLY>

    <!-- ============ CONDENSATEURS DE FILTRAGE ============ -->
    <COMPONENT ID="C_FILTER1">
      <REFERENCE>C1</REFERENCE>
      <VALUE>100µF</VALUE>
      <DESCRIPTION>Filtrage alimentation</DESCRIPTION>
      <POSITION>POWER_INPUT</POSITION>
    </COMPONENT>

    <COMPONENT ID="C_FILTER2">
      <REFERENCE>C2</REFERENCE>
      <VALUE>10µF</VALUE>
      <DESCRIPTION>Découplage Arduino</DESCRIPTION>
    </COMPONENT>

    <COMPONENT ID="C_FILTER3">
      <REFERENCE>C3</REFERENCE>
      <VALUE>10µF</VALUE>
      <DESCRIPTION>Découplage Relais</DESCRIPTION>
    </COMPONENT>

    <!-- ============ RÉSISTANCES DE PROTECTION ============ -->
    <COMPONENT ID="R_PROTECT">
      <REFERENCE>R100</REFERENCE>
      <VALUE>10kΩ</VALUE>
      <DESCRIPTION>Pull-down protections entrées</DESCRIPTION>
      <QUANTITY>10</QUANTITY>
    </COMPONENT>

  </SCHEMATIC>

  <CONNECTIONS>
    <CONNECTION FROM="IC1_PIN20" TO="LCD1_SDA"/>
    <CONNECTION FROM="IC1_PIN21" TO="LCD1_SCL"/>
    <CONNECTION FROM="IC1_PIN22" TO="K1_IN"/>
    <CONNECTION FROM="IC1_PIN23" TO="K2_IN"/>
    <CONNECTION FROM="IC1_PIN24" TO="K3_IN"/>
    <CONNECTION FROM="IC1_PIN25" TO="K4_IN"/>
    <CONNECTION FROM="IC1_PIN26" TO="K5_IN"/>
    <CONNECTION FROM="IC1_PIN27" TO="K6_IN"/>
    <CONNECTION FROM="IC1_PIN28" TO="SW1"/>
    <CONNECTION FROM="IC1_PIN29" TO="SW2"/>
    <CONNECTION FROM="IC1_PIN30" TO="SW3"/>
    <CONNECTION FROM="IC1_PIN31" TO="SW4"/>
    <CONNECTION FROM="IC1_PIN32" TO="SW5"/>
    <CONNECTION FROM="IC1_PIN33" TO="SW6"/>
    <CONNECTION FROM="IC1_PIN34" TO="SW7"/>
    <CONNECTION FROM="IC1_PIN35" TO="SW8"/>
    <CONNECTION FROM="IC1_A0" TO="POT1"/>
    <CONNECTION FROM="IC1_A1" TO="POT2"/>
    <CONNECTION FROM="IC1_A2" TO="POT3"/>
    <CONNECTION FROM="IC1_A3" TO="POT4"/>
    <CONNECTION FROM="VCC_5V" TO="LCD1_VCC"/>
    <CONNECTION FROM="VCC_5V" TO="K1_VCC"/>
    <CONNECTION FROM="VCC_5V" TO="K2_VCC"/>
    <CONNECTION FROM="VCC_5V" TO="K3_VCC"/>
    <CONNECTION FROM="VCC_5V" TO="K4_VCC"/>
    <CONNECTION FROM="VCC_5V" TO="K5_VCC"/>
    <CONNECTION FROM="VCC_5V" TO="K6_VCC"/>
    <CONNECTION FROM="GND" TO="LCD1_GND"/>
    <CONNECTION FROM="GND" TO="K1_GND"/>
    <CONNECTION FROM="GND" TO="K2_GND"/>
    <CONNECTION FROM="GND" TO="K3_GND"/>
    <CONNECTION FROM="GND" TO="K4_GND"/>
    <CONNECTION FROM="GND" TO="K5_GND"/>
    <CONNECTION FROM="GND" TO="K6_GND"/>
  </CONNECTIONS>

  <SIMULATION>
    <SPEED>10MHz</SPEED>
    <TIMESTEP>AUTO</TIMESTEP>
    <MODE>INTERACTIVE</MODE>
    <STARTUP_DELAY>1000ms</STARTUP_DELAY>
  </SIMULATION>

</DESIGN>
