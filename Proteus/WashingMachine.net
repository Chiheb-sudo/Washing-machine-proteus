      (pin "4" (name "NO") (type "PASSIVE"))
      (pin "5" (name "NC") (type "PASSIVE"))))

(component LCD_MODULE_LCD1
   (library "WLIB")
   (reference "LCD1")
   (value "LCD20X4_I2C")
   (description "LCD 20x4 I2C Module - Address 0x27")
   (pins
      (pin "1" (name "GND") (type "GROUND"))
      (pin "2" (name "VCC") (type "POWER"))
      (pin "3" (name "SDA") (type "BIDIR"))
      (pin "4" (name "SCL") (type "BIDIR"))))

(component POT_R1
   (library "WLIB")
   (reference "R1")
   (value "10K")
   (description "10K Potentiometer - Water Level Sensor")
   (pins
      (pin "1" (name "VCC") (type "POWER"))
      (pin "2" (name "OUT") (type "ANALOG"))
      (pin "3" (name "GND") (type "GROUND"))))

(component POT_R2
   (library "WLIB")
   (reference "R2")
   (value "10K")
   (description "10K Potentiometer - Soap Level Sensor")
   (pins
      (pin "1" (name "VCC") (type "POWER"))
      (pin "2" (name "OUT") (type "ANALOG"))
      (pin "3" (name "GND") (type "GROUND"))))

(component POT_R3
   (library "WLIB")
   (reference "R3")
   (value "10K")
   (description "10K Potentiometer - Detergent Level Sensor")
   (pins
