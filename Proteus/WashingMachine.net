      (pin "5" (name "NC") (type "PASSIVE"))))

(component RELAY_1K5
   (library "WLIB")
   (reference "K5")
   (value "RELAY-5V-5A")
   (description "Electromagnetic Relay 5V 5A - Drain Pump")
   (pins
      (pin "1" (name "IN") (type "INPUT"))
      (pin "2" (name "VCC") (type "POWER"))
      (pin "3" (name "GND") (type "GROUND"))
      (pin "4" (name "NO") (type "PASSIVE"))
      (pin "5" (name "NC") (type "PASSIVE"))))

(component RELAY_1K6
   (library "WLIB")
   (reference "K6")
   (value "RELAY-5V-5A")
   (description "Electromagnetic Relay 5V 5A - Spin Motor")
   (pins
      (pin "1" (name "IN") (type "INPUT"))
