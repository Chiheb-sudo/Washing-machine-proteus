;Proteus Design Interchange Format
(protos 1)
(fragment LIBRARY_IDENT
   (name "WLIB")
   (type SCHEMATIC))

(component MEGA2560_1
   (library "WLIB")
   (symbolVariantName "")
   (reference "U1")
   (value "MEGA2560")
   (datasheet "")
   (description "Arduino Mega 2560 Microcontroller")
   (properties
      (property "PACKAGE" "MEGA2560")
      (property "MPN" "ATMEGA2560")
      (property "MANUFACTURER" "Atmel")
      (property "FREQ" "16MHz")
      (property "FLASH" "256KB")
      (property "RAM" "8KB"))
   (pins
      (pin "1" (name "RESET") (type "INPUT"))
      (pin "2" (name "RXD0") (type "INPUT"))
      (pin "3" (name "TXD0") (type "OUTPUT"))
      (pin "20" (name "SDA") (type "BIDIR"))
      (pin "21" (name "SCL") (type "BIDIR"))
      (pin "22" (name "RELAY_1") (type "OUTPUT"))
      (pin "23" (name "RELAY_2") (type "OUTPUT"))
      (pin "24" (name "RELAY_3") (type "OUTPUT"))
      (pin "25" (name "RELAY_4") (type "OUTPUT"))
      (pin "26" (name "RELAY_5") (type "OUTPUT"))
      (pin "27" (name "RELAY_6") (type "OUTPUT"))
      (pin "28" (name "BTN_MENU") (type "INPUT"))
      (pin "29" (name "BTN_UP") (type "INPUT"))
      (pin "30" (name "BTN_DOWN") (type "INPUT"))
      (pin "31" (name "BTN_OK") (type "INPUT"))
      (pin "32" (name "SIG_START") (type "INPUT"))
      (pin "33" (name "SIG_STOP") (type "INPUT"))
      (pin "34" (name "SIG_MODE") (type "INPUT"))
      (pin "35" (name "SIG_TEMP") (type "INPUT"))
      (pin "A0" (name "SENSOR_WATER") (type "ANALOG_IN"))
      (pin "A1" (name "SENSOR_SOAP") (type "ANALOG_IN"))
      (pin "A2" (name "SENSOR_DETERGENT") (type "ANALOG_IN"))
      (pin "A3" (name "SENSOR_RINSE") (type "ANALOG_IN"))
      (pin "VCC" (name "VCC_5V") (type "POWER"))
      (pin "GND" (name "GND") (type "GROUND"))))

(component RELAY_1K1
   (library "WLIB")
   (reference "K1")
   (value "RELAY-5V-5A")
   (description "Electromagnetic Relay 5V 5A - Water Valve")
   (pins
      (pin "1" (name "IN") (type "INPUT"))
      (pin "2" (name "VCC") (type "POWER"))
      (pin "3" (name "GND") (type "GROUND"))
      (pin "4" (name "NO") (type "PASSIVE"))
      (pin "5" (name "NC") (type "PASSIVE"))))

(component RELAY_1K2
   (library "WLIB")
   (reference "K2")
   (value "RELAY-5V-5A")
   (description "Electromagnetic Relay 5V 5A - Soap Valve")
   (pins
      (pin "1" (name "IN") (type "INPUT"))
      (pin "2" (name "VCC") (type "POWER"))
      (pin "3" (name "GND") (type "GROUND"))
      (pin "4" (name "NO") (type "PASSIVE"))
      (pin "5" (name "NC") (type "PASSIVE"))))

