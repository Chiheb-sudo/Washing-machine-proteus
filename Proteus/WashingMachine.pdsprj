<?xml version="1.0" encoding="UTF-8"?>
<!-- Proteus Project File -->
<PROJECT>
  <HEADER>
    <VERSION>1.0</VERSION>
    <TITLE>Machine à Laver Automatisée - Proteus Simulation</TITLE>
    <AUTHOR>Chiheb-sudo</AUTHOR>
    <DATE>2024</DATE>
    <DESCRIPTION>Simulation complète machine à laver avec Arduino Mega</DESCRIPTION>
  </HEADER>
  
  <SETTINGS>
    <SIMULATION>
      <SPEED>10MHz</SPEED>
      <MODE>INTERACTIVE</MODE>
      <TIMESTEP>AUTO</TIMESTEP>
    </SIMULATION>
    <GRAPHICS>
      <RESOLUTION>1920x1080</RESOLUTION>
      <FULLSCREEN>FALSE</FULLSCREEN>
      <GRID>TRUE</GRID>
      <ZOOM>100</ZOOM>
    </GRAPHICS>
  </SETTINGS>
  
  <DOCUMENTS>
    <SCHEMATIC>
      <NAME>WashingMachine.dsn</NAME>
      <DESIGN_URL>WashingMachine.dsn</DESIGN_URL>
      <ACTIVE>TRUE</ACTIVE>
    </SCHEMATIC>
  </DOCUMENTS>
  
  <PROJECT_INFO>
    <DEVICE_COUNT>1</DEVICE_COUNT>
    <COMPONENT_COUNT>45</COMPONENT_COUNT>
    <CONNECTION_COUNT>120</CONNECTION_COUNT>
    <STATUS>READY_FOR_SIMULATION</STATUS>
  </PROJECT_INFO>
  
  <DESIGN_RULES>
    <ECLASS_POWER_SUPPLY>5V</ECLASS_POWER_SUPPLY>
    <MAX_FREQUENCY>16MHz</MAX_FREQUENCY>
    <SIMULATION_TIMEOUT>600s</SIMULATION_TIMEOUT>
  </DESIGN_RULES>
  
</PROJECT>
